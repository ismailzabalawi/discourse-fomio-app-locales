{
 "schema": 1,
 "reviewed": "2026-10-15",
 "discourse_reference": {
  "local_head": "d4296c5ecf2bef4f11e42d8f3fd2282c8752f4e2",
  "deployed": "7b4f0970506fb0ce7d4b6a851d252ace418330c8",
  "note": "Every mapped key exists with the same English value at both revisions."
 },
 "rules": [
  "discourse: resolve I18n.t(discourse_key, locale:) including that locale's site-text override. If the locale has no translation of its own (Discourse would fall back to English) or the resolved value fails app validation, use the maintained Fomio translation for this key instead.",
  "fomio: serve the maintained translation from Localization/catalogs/<locale>.json (English from Fomio/Resources/Localization/fomio-catalog-en.json).",
  "Convert Discourse %{name} interpolation to {name}; reject markup and values that are translation keys.",
  "Never apply an override from one locale to another locale."
 ],
 "terminology": {
  "decision": "Native interface nouns stay 'discussion' (topic) and 'community' (category/subcategory) in every locale. Site-text branding overrides for topic/category keys are not mapped.",
  "evidence": "Public /extra-locales/<digest>/en/overrides.js on 2026-10-15 (inspected, not used by the app): topic keys -> Byte/Bytes, category keys -> Hub, subcategory keys -> Teret/terets; inconsistent casing (js.topic.new = 'new byte' vs js.topic.create = 'New Byte'); js.category.all overridden to the literal key 'js.hubs.all'. Only English has overrides.",
  "to_adopt_branding": "Add a reviewed terminology variant per locale for every key that contains the noun (search the English catalog for discussion/community/subcommunity), then map them together. Do not substitute words."
 },
